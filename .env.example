# Data Source: 'google_sheet' (live API), 'xlsx' (local excel), 'csv', or 'mock'
DATA_SOURCE=google_sheet

# Local Data Source Files
CSV_FILE_PATH=sample_rides.csv
EXCEL_FILE_PATH=google_sheet.xlsx

# Google Sheets API Credentials (Required if DATA_SOURCE=google_sheet with gspread API)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Rides
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Voice Provider: 'twilio' or 'mock'
TWILIO_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199

# Server & Webhook Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_WEBHOOK_URL=http://localhost:8000

# Reminder Engine Settings
REMINDER_LEAD_MINUTES=30
REMINDER_WINDOW_TOLERANCE_MINUTES=5
POLL_INTERVAL_SECONDS=60
TIMEZONE=Asia/Kolkata
